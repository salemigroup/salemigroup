---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'CAL-Pathfinder',
  description = 'CAL-Pathfinder searches for ultralight dark matter — axions and axion-like particles — using quantum-limited electromagnetic receivers at UC Berkeley.',
} = Astro.props;

const pageTitle = title === 'CAL-Pathfinder' ? title : `${title} | CAL-Pathfinder`;
const base = import.meta.env.BASE_URL.replace(/\/$/, ''); // '/CAL-DMRadio' or ''
const pathname = Astro.url.pathname;

function isActive(path: string) {
  if (path === '/') return pathname === base + '/' || pathname === base;
  return pathname.startsWith(base + path) && path !== '/';
}

const researchDropdown = [
  { label: 'Dark Matter & Axions',       href: '/research/dark-matter/' },
  { label: 'Gravitational Waves',        href: '/research/gravitational-waves/' },
  { label: 'Lumped-Element Detectors',   href: '/research/lumped-element-detectors/' },
  { label: 'Quantum Sensing',            href: '/research/quantum-sensing/' },
  { label: 'Non-Proliferation',          href: '/research/non-proliferation/' },
];

const nav = [
  { label: 'Home',           href: '/' },
  { label: 'Research',       href: '/research/', dropdown: researchDropdown },
  { label: 'People',         href: '/people/' },
  { label: 'Publications',   href: '/publications/' },
  { label: 'Facilities',     href: '/facilities/' },
  { label: 'News',           href: '/news/' },
  { label: 'Join the Group', href: '/join/' },
  { label: 'Contact',        href: '/contact/' },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
    <link rel="icon" href={`${base}/favicon.ico`} />
    <meta name="generator" content={Astro.generator} />
    <title>{pageTitle}</title>
    <!-- OG -->
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
  </head>
  <body>

    <!-- ── Header ── -->
    <header class="site-header">
      <nav class="nav-inner">
        <a href={`${base}/`} class="nav-logo">Salemi <span>Group</span></a>

        <ul class="nav-links">
          {nav.map(({ label, href, cta, dropdown }) => (
            <li class:list={[{ 'has-dropdown': dropdown }]}>
              <a
                href={`${base}${href}`}
                class:list={[{ active: isActive(href), 'nav-cta': cta }]}
              >
                {label}{dropdown && <span class="dropdown-arrow" aria-hidden="true">▾</span>}
              </a>
              {dropdown && (
                <ul class="dropdown-menu">
                  {dropdown.map((item) => (
                    <li>
                      <a href={`${base}${item.href}`} class:list={[{ active: isActive(item.href) }]}>
                        {item.label}
                      </a>
                    </li>
                  ))}
                </ul>
              )}
            </li>
          ))}
        </ul>

        <button class="nav-hamburger" id="hamburger" aria-label="Open menu">
          <span></span><span></span><span></span>
        </button>
      </nav>

      <!-- Mobile menu -->
      <nav class="nav-mobile" id="nav-mobile">
        <a href={`${base}/`}>Home</a>
        {nav.filter(({ href }) => href !== '/').map(({ label, href, cta, dropdown }) => (
          <>
            <a href={`${base}${href}`} class:list={[{ cta }]}>{label}</a>
            {dropdown && dropdown.filter((item) => item.href !== href).map((item) => (
              <a href={`${base}${item.href}`} class="mobile-sub">{item.label}</a>
            ))}
          </>
        ))}
      </nav>
    </header>

    <!-- ── Main ── -->
    <main>
      <slot />
    </main>

    <!-- ── Footer ── -->
    <footer class="site-footer">
      <div class="container">
        <div class="footer-grid">
          <div>
            <div class="footer-brand">Salemi Group</div>
            <p class="footer-desc">
              A UC Berkeley experiment searching for ultralight dark matter using
              quantum-limited electromagnetic receivers.
            </p>
          </div>
          <div>
            <div class="footer-heading">Research</div>
            <ul class="footer-links">
              <li><a href={`${base}/research/dark-matter/`}>Dark Matter &amp; Axions</a></li>
              <li><a href={`${base}/research/gravitational-waves/`}>Gravitational Waves</a></li>
              <li><a href={`${base}/research/lumped-element-detectors/`}>Lumped-Element Detectors</a></li>
              <li><a href={`${base}/research/lumped-element-detectors/publications/`}>Publications</a></li>
              <li><a href={`${base}/research/lumped-element-detectors/talks/`}>Talks</a></li>
            </ul>
          </div>
          <div>
            <div class="footer-heading">More</div>
            <ul class="footer-links">
              <li><a href={`${base}/people/`}>People</a></li>
              <li><a href={`${base}/facilities/`}>Facilities</a></li>
              <li><a href={`${base}/news/`}>News</a></li>
              <li><a href={`${base}/join/`}>Join the Group</a></li>
              <li><a href={`${base}/contact/`}>Contact</a></li>
            </ul>
          </div>
        </div>
        <div class="footer-bottom">
          <span class="footer-copy">&copy; {new Date().getFullYear()} Salemi Group · UC Berkeley</span>
          <span class="footer-copy">Department of Physics</span>
        </div>
      </div>
    </footer>

    <script>
      const btn = document.getElementById('hamburger');
      const menu = document.getElementById('nav-mobile');
      btn?.addEventListener('click', () => menu?.classList.toggle('open'));
      // Close on outside click
      document.addEventListener('click', (e) => {
        if (!btn?.contains(e.target as Node) && !menu?.contains(e.target as Node)) {
          menu?.classList.remove('open');
        }
      });
    </script>

  </body>
</html>
