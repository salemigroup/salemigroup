---
import Layout from '../../layouts/Layout.astro';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<Layout
  title="Publications"
  description="Publications from the CAL-Pathfinder collaboration."
>

  <section class="page-header">
    <div class="container">
      <!--<span class="eyebrow">Research Output</span>-->
      <h1>Publications</h1>
      <p class="desc">
        Papers, theses, and presentations from the CAL DMRadio collaboration.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <p style="color:var(--gray-400);">Content coming soon. In the meantime, see <a href={`${base}/research/publications/`} style="color:var(--blue);">Research &rsaquo; Publications</a>.</p>
    </div>
  </section>

</Layout>
