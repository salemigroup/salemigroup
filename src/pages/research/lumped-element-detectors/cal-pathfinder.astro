---
import Layout from '../../../layouts/Layout.astro';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const citations = [
  {
    key: 'ankel2025',
    html: 'V. Ankel et al., "Noise limits for dc SQUID readout of high-<em>Q</em> resonators below 300 MHz," <em>J. Appl. Phys.</em> <strong>138</strong>, 094505 (2025)',
    doi: 'https://doi.org/10.1063/5.0280831',
    doiLabel: '10.1063/5.0280831',
  },
];
---

<Layout
  title="CAL-Pathfinder"
  description="How the CAL DMRadio experiment works: solenoidal LC resonator, SQUID amplifiers, and quantum-limited axion searches."
>

  <!-- Page header -->
  <section class="page-header">
    <div class="container">
      <h1>CAL-Pathfinder</h1>
    </div>
  </section>

  <!-- What is DMRadio 
  <section class="section">
    <div class="container">
      <div class="two-col-60">
        <div>
          <h2 style="margin-bottom:1.25rem;">What is DMRadio?</h2>
          <p style="margin-bottom:1.25rem;">
            DMRadio is a resonant search for axion dark matter in the sub-&mu;eV mass range. In a strong static magnetic field, the axion-photon coupling modifies Maxwell's equations and produces a tiny effective oscillating current, which DMRadio detects with a coaxial inductive pickup coupled to a tunable LC resonator and a DC SQUID readout chain. Because the targeted axion masses correspond to wavelengths much larger than the detector, the apparatus operates in the lumped-element regime rather than as a conventional cavity haloscope.
          </p>
          <p style="margin-bottom:0;">
            Resonant tuning enhances the axion-induced response at a chosen frequency, and scanning that resonance over time allows the experiment to probe a range of possible axion masses. Achieving sensitivity to such weak signals requires high quality factor, careful control of parasitic modes and detector losses, cryogenic operation near 20 mK, and low-noise SQUID amplification.
          </p>
        </div>
      </div>
    </div>
  </section>

-->

  <hr class="divider">

  <!-- What is CAL-Pathfinder -->
  <section class="section">
    <div class="container">
      <div class="two-col-60">
        <div>
          <h2 style="margin-bottom:1.25rem;">CAL-Pathfinder</h2>
          <p style="margin-bottom:1.25rem;">
            The Cal Axion LC (CAL-Pathfinder) experiment develops and characterizes the coaxial pickup and tunable LC resonator architecture used in DMRadio's lumped-element axion search. In this design, the coaxial pickup converts the axion-induced electromagnetic response into a measurable circuit signal, while the tunable LC resonator sets the resonant frequency and provides the narrowband enhancement needed for sensitive readout.
          </p>
          <p style="margin-bottom:0;">
            Characterization means measuring not only where the device resonates, but how sharply it resonates, how smoothly it tunes, and whether its electromagnetic field structure matches the intended mode. In practice, this is done through resonance-curve measurements, tuning studies, comparison to simulation, and bead-pull measurements, in which a small perturbing bead is moved through the structure to map the field distribution by tracking shifts in resonant frequency. Together, these measurements reveal distortions, parasitic modes, and other non-ideal effects that determine whether the coaxial resonator is suitable for a precision axion search.
          </p>
        </div>
      </div>
    </div>
  </section>

  <hr class="divider">

  <!-- How Lumped-Element Works -->
  <section class="section">
    <div class="container">
      <div class="two-col-60">
        <div>
          <h2 style="margin-bottom:1.25rem;">Detection Principle</h2>
          <p style="margin-bottom:1.25rem;">
            CAL-Pathfinder relies on the lumped-element technique for axion detection. A 9 T solenoidal superconducting magnet is attached to a Bluefors LD400 dilution refrigerator. An inductive, coaxial pickup hangs off the mixing chamber of the dilution fridge and resides within the bore of the magnet. Attached to the pickup is a tunable capacitor. Axion interactions with the magnetic field induce a current on the surface of the pickup. These induced currents travel through the LC circuit formed by the pickup and capacitor and are read out by a DC SQUID amplifier chain. The pickup, capacitor, and SQUID amplifiers all operate at temperatures near 20 mK. The SQUID provides quantum-limited noise performance essential for
            detecting the extraordinarily faint axion-induced currents at the target sensitivity. As a pathfinder instrument, CAL-Pathfinder will validate the lumped-element detection principle at frequencies above 100 MHz, demonstrate the performance of a solenoidal superconducting magnet and coaxial pickup structure, and develops the cryogenic readout hardware required for future, larger DMRadio experiments.
          </p>
        </div>
        <div style="display:flex;flex-direction:column;gap:1rem;">
          <div class="diagram-placeholder">
            <p><strong>Detector schematic</strong></p>
            <p>Coaxial pickup coil + SQUID chain</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <hr class="divider">

  <!-- Interactive diagram -->
  <section class="section-sm">
    <div class="container">
      <h2 style="margin-bottom:1.5rem;">Explore the Experiment</h2>
      <div class="hotspot-layout">

        <div class="hotspot-wrapper">
          <img
            src={`${base}/images/cal-path_placeholder.png`}
            alt="CAL-Pathfinder experiment diagram"
            class="hotspot-image"
          />

          <div class="hotspot" style="left:65%;top:85%;" data-label="Magnet" data-img="" data-desc="CAL Pathfinder utilizes a solenoid for lumped element detection, this magnet is 9T and will be thermalized at 4K, in the dilution fridge. Axion-photon conversion is driven by the inverse primakoff effect, in which axions are converted to photons and an axion B-field is generated, the quantity we wish to detect.">
            <button class="hotspot-btn" aria-label="Magnet">+</button>
            <span class="hotspot-label">Magnet</span>
          </div>

          <div class="hotspot" style="left:50%;top:68%;" data-label="Coaxial pickup" data-img="" data-desc="The axion signal acts as an effective current source that is inductively coupled to the LC resonator, which is tuned to the axion mass via a tunable capacitor. The tunability of the resonator allows us to search over a broader frequency range.">
            <button class="hotspot-btn" aria-label="Coaxial pickup">+</button>
            <span class="hotspot-label">Coaxial pickup</span>
          </div>

          <div class="hotspot" style="left:35%;top:30%;" data-label="Cryogenic System" data-img="" data-desc="The CAL experiment will be housed in a Bluefors LD400 dilution refrigerator. The fridge will also be equipped with a 9T solenoidal magnet from American Magnetics, Inc., which is designed to mate with the plates of the LD400 and share vacuum and cryocooling. The targeted system temperature for CAL Pathfinder is 20mK.">
            <button class="hotspot-btn" aria-label="Cryogenic System">+</button>
            <span class="hotspot-label">Cryogenic System</span>
          </div>

          <div class="hotspot" style="left:35%;top:44%;" data-label="SQUIDs" data-img="" data-desc="The amplifier chain consists of a first stage single dc SQUID, followed by a strongly coupled second stage SQUID array and a cryogenic follow-on RF amplifier.[cite:ankel2025] With this system, we can achieve a noise performance that is only a factor of 10-20 above the SQL (Standard Quantum Limit) at the frequencies we are interested in here.">
            <button class="hotspot-btn" aria-label="SQUIDs">+</button>
            <span class="hotspot-label">SQUIDs</span>
          </div>

          <div class="hotspot" style="left:63%;top:44%;" data-label="Low-field box" data-img="" data-desc="Coming soon.">
            <button class="hotspot-btn" aria-label="Low-field box">+</button>
            <span class="hotspot-label">Low-field box</span>
          </div>

          <div class="hotspot" style="left:54%;top:34%;" data-label="Tunable capacitor" data-img="" data-desc="Coming soon.">
            <button class="hotspot-btn" aria-label="Tunable capacitor">+</button>
            <span class="hotspot-label">Tunable capacitor</span>
          </div>
        </div>

        <div class="hotspot-info" id="hotspot-info">
          <p class="hotspot-info-prompt">Click a <strong>+</strong> to learn about each component.</p>
        </div>

      </div>
    </div>
  </section>

  <hr class="divider">

  <!-- References -->
  <section class="section">
    <div class="container">
      <h2 style="margin-bottom:1.5rem;">Sources</h2>
      <div style="max-width:800px;">
        <ol style="font-size:0.9rem;line-height:1.8;color:var(--gray-700);padding-left:1.5rem;">
          {citations.map(({ html, doi, doiLabel }) => (
            <li>
              <span set:html={html} /> — <a href={doi} style="color:var(--blue);text-decoration:none;" target="_blank" rel="noopener">{doiLabel}</a>
            </li>
          ))}
        </ol>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="section-sm" style="background:var(--gray-50);border-top:1px solid var(--gray-200);">
    <div class="container" style="text-align:center;">
      <h3 style="margin-bottom:0.75rem;">Want to learn more?</h3>
      <div style="display:flex;gap:1rem;justify-content:center;flex-wrap:wrap;">
        <a href={`${base}/publications/`} class="btn btn-primary">Publications</a>
      </div>
    </div>
  </section>

</Layout>

<style>
  /* ── Hotspot diagram ── */
  .hotspot-layout {
    display: flex;
    gap: 2rem;
    align-items: flex-start;
  }
  .hotspot-wrapper {
    position: relative;
    width: 100%;
    max-width: 500px;
    flex-shrink: 0;
  }
  .hotspot-image {
    width: 100%;
    height: auto;
    display: block;
    border-radius: var(--radius);
  }
  .hotspot {
    position: absolute;
    transform: translate(-50%, -50%);
  }
  .hotspot-btn {
    width: 28px;
    height: 28px;
    border-radius: 50%;
    border: 2px solid rgba(255,255,255,0.9);
    background: rgba(0,50,98,0.82);
    color: #fff;
    font-size: 1.1rem;
    font-weight: 700;
    line-height: 1;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background 0.15s, transform 0.15s;
    position: relative;
    z-index: 1;
  }
  .hotspot-btn:hover,
  .hotspot-btn:focus { background: var(--blue); transform: scale(1.18); outline: none; }
  .hotspot.active .hotspot-btn { background: var(--blue); }
  .hotspot-label {
    position: absolute;
    bottom: calc(100% + 8px);
    left: 50%;
    transform: translateX(-50%);
    background: var(--gray-900);
    color: #fff;
    padding: 0.3rem 0.7rem;
    border-radius: 5px;
    font-size: 0.8rem;
    font-weight: 500;
    white-space: nowrap;
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.15s;
    z-index: 10;
  }
  .hotspot-label::after {
    content: '';
    position: absolute;
    top: 100%; left: 50%;
    transform: translateX(-50%);
    border: 5px solid transparent;
    border-top-color: var(--gray-900);
  }
  .hotspot:hover .hotspot-label,
  .hotspot-btn:focus + .hotspot-label { opacity: 1; }
  /* ── Info panel ── */
  .hotspot-info {
    flex: 1;
    border: 1px solid var(--gray-200);
    border-radius: var(--radius);
    padding: 1.5rem;
    min-height: 180px;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }
  .hotspot-info-prompt {
    color: var(--gray-400);
    font-size: 0.9rem;
    text-align: center;
  }
  .hotspot-info h3 {
    color: var(--blue);
    margin-bottom: 0.75rem;
  }
  .hotspot-info-img {
    width: 100%;
    height: auto;
    border-radius: var(--radius);
    margin-top: 1rem;
  }
  @media (max-width: 700px) {
    .hotspot-layout { flex-direction: column; }
    .hotspot-wrapper { max-width: 100%; }
  }
</style>

<script define:vars={{ citations }}>
  // Build key → 1-based index map from the frontmatter citations array
  const citeMap = Object.fromEntries(citations.map((c, i) => [c.key, i + 1]));

  function renderDesc(desc) {
    return desc.replace(/\[cite:([^\]]+)\]/g, (_, key) => {
      const n = citeMap[key];
      return n != null ? `<sup>${n}</sup>` : '';
    });
  }

  const PROMPT = '<p class="hotspot-info-prompt">Click a <strong>+</strong> to learn about each component.</p>';
  const info = document.getElementById('hotspot-info');

  document.querySelectorAll('.hotspot-btn').forEach(btn => {
    btn.addEventListener('click', e => {
      e.stopPropagation();
      const hotspot = btn.closest('.hotspot');
      const isActive = hotspot.classList.contains('active');

      document.querySelectorAll('.hotspot').forEach(h => h.classList.remove('active'));

      if (isActive) {
        info.innerHTML = PROMPT;
      } else {
        hotspot.classList.add('active');
        const label = hotspot.dataset.label;
        const desc = renderDesc(hotspot.dataset.desc);
        const img = hotspot.dataset.img;
        const imgHtml = img ? `<img src="${img}" alt="${label}" class="hotspot-info-img" />` : '';
        info.innerHTML = `<h3>${label}</h3><p>${desc}</p>${imgHtml}`;
      }
    });
  });

  document.addEventListener('click', e => {
    if (!e.target.closest('.hotspot')) {
      document.querySelectorAll('.hotspot').forEach(h => h.classList.remove('active'));
      info.innerHTML = PROMPT;
    }
  });
</script>
