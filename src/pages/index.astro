---
import Layout from '../layouts/Layout.astro';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<Layout
  title="Salemi Group"
  description="The Salemi group searches for ultralight dark matter — axions and axion-like particles — using quantum-limited sensors at UC Berkeley."
>

  <section class="page-header" style="padding:2rem 0 1.5rem;">
    <div class="container">
      <h1>Salemi Group</h1>
      <p class="desc">
        Searching for axion dark matter and other new physics with quantum sensors.
      </p>
    </div>
  </section>

  <section class="section" style="padding:2rem 0;">
    <div class="container">
      <div class="grid-2">

        <a href={`${base}/research/dark-matter/`} class="card card-grow" style={`text-decoration:none; background-image: linear-gradient(rgba(0,0,0,0.35), rgba(0,0,0,0.6)), url('${base}/images/bullet-cluster.jpg');`}>
          <h3 class="card-title">Dark Matter &amp; Axions</h3>
        </a>

        <a href={`${base}/research/quantum-sensing/`} class="card card-grow" style={`text-decoration:none; background-image: linear-gradient(rgba(0,0,0,0.35), rgba(0,0,0,0.6)), url('${base}/images/quantum_sense.jpeg');`}>
          <h3 class="card-title">Quantum Sensors</h3>
        </a>

      </div>
    </div>
  </section>

  <section class="section" style="padding:1rem 0 2rem;">
    <div class="container">
      <figure style="margin:0;">
        <img
          src={`${base}/images/salemi_group_sep2026.JPG`}
          alt="Salemi Group photo, September 2026"
          style="width:100%;border-radius:8px;display:block;"
        />
        <figcaption style="font-size:0.78rem;color:var(--gray-500);margin-top:0.6rem;line-height:1.5;text-align:center;">
          The Salemi Group, September 2026.
        </figcaption>
      </figure>
    </div>
  </section>

</Layout>

<style>
  .card-grow {
    min-height: 220px;
    display: flex;
    align-items: flex-end;
    background-size: cover;
    background-position: center;
    border: none;
    transition: box-shadow 0.2s, min-height 0.3s, transform 0.2s;
  }
  .card-grow:hover {
    min-height: 240px;
    padding-top: 2.25rem;
    padding-bottom: 2.25rem;
    transform: none;
  }
  .card-title {
    color: #fff;
    text-shadow: 0 1px 4px rgba(0,0,0,0.6);
    margin: 0;
  }
</style>
